{
  "name": "nocad",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "pnpm verify:boundaries && pnpm verify:fixtures && pnpm verify:semantic-fixtures && pnpm verify:north-star && turbo run test",
    "verify:boundaries": "node scripts/verify-general-boundaries.mjs",
    "verify:fixtures": "node scripts/verify-kicad-fixtures.mjs",
    "verify:semantic-fixtures": "node scripts/verify-semantic-fixtures.mjs",
    "verify:north-star": "node scripts/verify-north-star-reference.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "turbo": "^2.6.3"
  }
}
